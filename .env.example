# ===========================================================================
# Configuration - this is the only file you edit.
#
# Copy to `.env` and fill it in, or just run .\start.ps1 and let it write one.
# repo\.env is generated from this file on every run. Don't edit that; your
# changes get overwritten.
# ===========================================================================

# --- Set these -------------------------------------------------------------

# Where every message is archived, both directions.
MONGO_URI=mongodb://user:pass@your-mongo-host:27017/?authSource=admin

# --- Generated once - keep them secret, no need to change them -------------

# What you send from Postman:  Authorization: Bearer <this>
BRIDGE_API_KEY=a-long-random-string

# Shared with the WhatsApp gateway. start.ps1 copies it into repo\.env.
OPENWA_API_KEY=another-long-random-string

# Signs the gateway's internal event deliveries to the bridge. Min 16 chars.
EVENTS_SECRET=a-third-long-random-string

# --- Optional --------------------------------------------------------------
# Everything else has a working default and only belongs here if you are
# changing it. The full set, with defaults:
#
#   BRIDGE_HOST=0.0.0.0           127.0.0.1 to refuse everything but this machine
#   BRIDGE_PORT=8000              the port Postman talks to
#   LOG_LEVEL=info                debug for more detail
#
#   MONGO_DB=openwa               database name
#   MONGO_COLLECTION=messages     where messages land
#   MONGO_EVENTS_COLLECTION=events  raw event envelopes
#   STORE_RAW_EVENTS=true         false keeps only parsed messages
#
#   OPENWA_BASE_URL=http://127.0.0.1:2785
#   OPENWA_SESSION_NAME=default   which WhatsApp session to drive
#   OPENWA_TIMEOUT=30
#
#   EVENTS_PATH=/webhooks/openwa  where the gateway delivers events
#   EVENTS_URL=                   defaults to http://127.0.0.1:<port><path>
#   EVENTS_AUTO_REGISTER=true     set the subscription up at startup
#   EVENTS_SUBSCRIBE=message.received,message.sent,message.ack,message.failed,message.revoked,message.edited,session.status
#
#   DEFAULT_COUNTRY_CODE=         e.g. 91 to accept bare 10-digit numbers.
#                                 Empty is safer: it forces every number to
#                                 carry its country code.
