# ===========================================================================
# OpenWA Bridge configuration
# ===========================================================================

# --- The bridge HTTP server (what Postman talks to) -----------------------
# POST http://<host>:<port>/send   {"id": "919876543210", "msg": "hello"}
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8000
# Required on every /send request as the X-API-Key header.
BRIDGE_API_KEY=generate-a-long-random-string
LOG_LEVEL=info

# --- MongoDB --------------------------------------------------------------
# Every message, both directions, is stored here.
MONGO_URI=mongodb://user:pass@your-mongo-host:27017/?authSource=admin
MONGO_DB=openwa
MONGO_COLLECTION=messages
MONGO_EVENTS_COLLECTION=events
# Keep the raw event envelopes as well as the parsed messages.
STORE_RAW_EVENTS=true

# --- Outbound queue polling (pull model - no inbound connectivity needed) --
# The bridge GETs this URL every POLL_INTERVAL seconds and sends whatever comes
# back. Nothing connects inward, so a PC anywhere can queue a message on your
# server and it goes out from here without this machine being reachable.
#
# Commonly the SAME URL as WEBHOOK_URL above, distinguished by method:
#   POST = an incoming WhatsApp message arriving at your server
#   GET  = "anything waiting to go out?"
#
# Response: {"id": "919876543210", "msg": "Hello"}  - or an array of those.
#   id  = the DESTINATION (this differs from the old winspark behaviour, where
#         id was the dedup key and the chat came from the per-chat URL)
#   msg = the text; message/text/content/body/reply also accepted
#   _id / message_id / messageId / external_id / uid = optional dedup id
# An empty body or {} means "nothing waiting" and also tells the bridge your
# endpoint dequeues, which turns off repeat suppression.
#
# Leave empty to disable polling.
POLL_URL=https://your.server/endpoint
# Bearer token sent with the GET.
POLL_TOKEN=your-bearer-token
POLL_INTERVAL=3
POLL_TIMEOUT=15

# --- OpenWA gateway -------------------------------------------------------
OPENWA_BASE_URL=http://127.0.0.1:2785
# Must match API_MASTER_KEY in ../repo/.env
OPENWA_API_KEY=must-match-API_MASTER_KEY-in-repo/.env
# The session is created automatically at startup under this name; you start
# and scan it once in the dashboard at http://localhost:2785
OPENWA_SESSION_NAME=default
OPENWA_TIMEOUT=30

# --- Event ingress (OpenWA -> bridge, internal) ---------------------------
# Loopback plumbing. This is NOT your endpoint - that is WEBHOOK_URL above.
EVENTS_PATH=/webhooks/openwa
# HMAC signing key, minimum 16 chars. OpenWA signs every delivery with it.
EVENTS_SECRET=generate-a-long-random-string
EVENTS_URL=http://127.0.0.1:8000/webhooks/openwa
EVENTS_AUTO_REGISTER=true
EVENTS_SUBSCRIBE=message.received,message.sent,message.ack,message.failed,message.revoked,message.edited,session.status

# --- Phone numbers --------------------------------------------------------
# Leave empty to require a full country code in every "id" (recommended).
# Set to e.g. 91 to let bare national numbers through.
DEFAULT_COUNTRY_CODE=
